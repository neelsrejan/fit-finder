# Copy into the Streamlit Community Cloud secrets editor only if you need an override.
# Do not commit secrets.toml. Do not paste a Neon URL, a Kaggle key, or any token.
# The walkthrough calls the public Render API. That service already holds
# FIT_FINDER_DATABASE_URL. Leave the database line empty.

# Optional. The default is the origin in deploy/public.json.
# FIT_FINDER_PUBLIC_API_URL = "https://fit-finder-27yw.onrender.com"

# Leave unset on the public app. "synthetic" is the CI fallback, not the demo.
# FIT_FINDER_GUIDE_BACKEND = "auto"

# FIT_FINDER_DATABASE_URL stays on Render. Do not set it here.
