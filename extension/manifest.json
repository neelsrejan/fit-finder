{
  "manifest_version": 3,
  "name": "fit-finder",
  "version": "0.1.0",
  "description": "Size and similar-item suggestions for the bundled fit-finder demo store. Does not run on retailer sites.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_title": "fit-finder demo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "css": ["panel.css"]
    }
  ]
}
