# Copy to .env for local runs. Never commit .env.
# The API scores with the committed model when none of these are set.
# CI uses the synthetic fixture and does not read this file.

# Optional path overrides.
# FIT_FINDER_MODEL=models/size_model.joblib
# FIT_FINDER_CATALOG=models/catalog.parquet
# FIT_FINDER_EVENTS=data/events/events.jsonl

# Neon Free plan, direct connection string (hostname without -pooler).
# Create the project at https://neon.com (no credit card). Do not commit the value.
# Leave it empty until the project exists. The API then reports reviews_host=not_configured.
# FIT_FINDER_DATABASE_URL=
# FIT_FINDER_REQUIRE_HOSTED_STORE=0

# Filled after Render prints the service origin. This value is public.
# The same origin goes in deploy/public.json and extension/config.js.
# The Streamlit tour reads it when set, otherwise deploy/public.json.
# FIT_FINDER_PUBLIC_API_URL=

# Walkthrough source. Unset or auto: call the API, and if it does not answer
# use the committed public-review artifact. public_artifact skips the network.
# synthetic is the CI fallback and is not the hosted table.
# FIT_FINDER_GUIDE_BACKEND=auto

# H&M Personalized Fashion Recommendations stays off the public API.
# The competition license is non-commercial and academic research, with no
# redistribution. A private download still needs the rules accepted in a
# browser, then these three. Do not load that file into Neon.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# FIT_FINDER_ALLOW_KAGGLE_DOWNLOAD=0

# Power BI has no key in this file. A free license cannot publish a public report.
