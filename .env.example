# Copy to .env for local runs. Never commit .env.
# The API and the trainers run with none of these set.

# Optional path overrides.
# FIT_FINDER_MODEL=models/size_model.joblib
# FIT_FINDER_CATALOG=models/catalog.parquet
# FIT_FINDER_EVENTS=data/events/events.jsonl

# H&M Personalized Fashion Recommendations is blocked until Neel
# accepts the Kaggle competition rules and creates an API token.
# Leave the download flag unset. The code will not call Kaggle.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# FIT_FINDER_ALLOW_KAGGLE_DOWNLOAD=0

# Power BI publish-to-web uses Neel's Microsoft account in the
# Power BI service. There is no key to put here.
